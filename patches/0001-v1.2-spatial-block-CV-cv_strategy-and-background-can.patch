+  occ_xy <- rbind(occ_xy, bxy)
+  resp   <- c(resp, rep(NA_integer_, nrow(bxy)))
+  message("Background candidates for pseudo-absences: ", nrow(bxy), " (", basename(bg_file), ")")
+}
