+  CV.user.table = cv_user_table,
+  CV.k        = cv_k,
+  CV.nb.rep   = if (cv_strategy == "block") 1L else cv_rep,
   metric.eval = c("AUCroc", "TSS", "BOYCE"),
   var.import  = 3,
   prevalence  = 0.5,        # Barbet-Massin et al. (2012): varlik/yokluk esit agirlik
