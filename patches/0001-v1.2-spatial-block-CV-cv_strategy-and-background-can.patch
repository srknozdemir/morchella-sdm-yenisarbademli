+# -------------------- ARKA PLAN ADAYLARI (opsiyonel, v1.2) --------------------
+# cfg$bg_file: x,y sutunlu CSV. Bu noktalar yanit degiskenine NA olarak eklenir;
+# biomod2 bu durumda sozde-yokluklari YALNIZ bu adaylar arasindan secer. Boylece
+# ornekleme yanliligina gore agirliklandirilmis arka plan kullanilabilir
+# (Phillips et al. 2009).
+bg_file <- as.character(cfg$bg_file %||% "")[1]
+use_bg  <- nzchar(bg_file) && file.exists(bg_file)
+if (use_bg) {
+  bg  <- read_user_csv(bg_file)
