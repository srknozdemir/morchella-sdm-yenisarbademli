@@ -644,13 +665,53 @@ built_opts <- bmopt_build(
 bmopt_report(built_opts, file.path(cfg$out_dir, "modeling_options_applied.csv"),
              data_type = "binary", p = p_env, n = n_pres)
 
+# ---- Mekansal blok CV tablosu (v1.2) ----
+# biomod2'nin "block" stratejisi ENMeval paketini gerektirir. Ayni duzen
+# (Muscarella et al. 2014: varliklar boylam medyaniyla ikiye, her yari enlem
+# medyaniyla ikiye bolunur; diger noktalar ayni sinirlarla atanir) burada
+# yeniden kurulur ve "user.defined" olarak verilir.
+block4_assign <- function(xy_p, xy_o) {
+  lon <- stats::median(xy_p[, 1])
+  gp <- integer(nrow(xy_p)); go <- integer(nrow(xy_o))
+  for (side in 0:1) {
+    ip <- if (side == 0) xy_p[, 1] <= lon else xy_p[, 1] > lon
+    io <- if (side == 0) xy_o[, 1] <= lon else xy_o[, 1] > lon
+    lat <- stats::median(xy_p[ip, 2])
+    gp[ip] <- side * 2 + ifelse(xy_p[ip, 2] <= lat, 1L, 2L)
+    go[io] <- side * 2 + ifelse(xy_o[io, 2] <= lat, 1L, 2L)
+  }
+  list(p = gp, o = go)
+}
+block_cv_table <- function(bf) {
+  sp <- bf@data.species; sp[is.na(sp)] <- 0
+  xy <- as.matrix(bf@coord)
+  pa_tab <- tryCatch(bf@PA.table, error = function(e) NULL)
+  if (is.null(pa_tab) || ncol(pa_tab) == 0) pa_tab <- data.frame(PA1 = rep(TRUE, length(sp)))
+  out <- NULL
+  for (pa in seq_len(ncol(pa_tab))) {
+    ind <- which(pa_tab[, pa] == TRUE)
+    s <- sp[ind]; b <- block4_assign(xy[ind[s == 1], , drop = FALSE], xy[ind[s == 0], , drop = FALSE])
+    m <- matrix(NA, nrow = length(sp), ncol = 4)
+    for (k in 1:4) { m[ind[s == 1], k] <- b$p != k; m[ind[s == 0], k] <- b$o != k }
+    colnames(m) <- if (inherits(bf, "BIOMOD.formated.data.PA")) paste0("_PA", pa, "_RUN", 1:4) else paste0("_allData_RUN", 1:4)
+    out <- cbind(out, m)
+  }
+  out
+}
+cv_user_table <- NULL
+if (cv_strategy == "block") {
+  cv_user_table <- block_cv_table(biomod_data)
+  message("Spatial block CV: 4 blocks x ", ncol(cv_user_table) / 4, " PA set(s)")
+}
+
 mod_args <- list(
   bm.format   = biomod_data,
