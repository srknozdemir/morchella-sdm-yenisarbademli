Subject: [PATCH 2/3] v1.2: project_full_models option; for_all_datasets key
 for biomod2 4.3

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G2GG4boqzjcLUzZ6wQWkMG
---
 biomod_opts.R |  9 +++++----
 run_biomod.R  | 20 ++++++++++++++++++--
 2 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/biomod_opts.R b/biomod_opts.R
index 923f270..e8b5884 100644
--- a/biomod_opts.R
+++ b/biomod_opts.R
@@ -443,7 +443,8 @@ bmopt_build <- function(data_type, models, bm_format, p, n,
 
   # Bir algoritma blogunu iki anahtarlama bicimiyle dener
   wrap_val <- function(nm, v, style) {
-    if (identical(style, "all")) list('_for_all_datasets' = v)
+    if (identical(style, "all2")) list(for_all_datasets = v)        # biomod2 >= 4.3
+    else if (identical(style, "all")) list('_for_all_datasets' = v)
     else stats::setNames(rep(list(v), length(ds_keys(nm))), ds_keys(nm))
   }
 
@@ -464,7 +465,7 @@ bmopt_build <- function(data_type, models, bm_format, p, n,
     nm <- nm[1]
 
     placed <- FALSE
-    for (style in c("all", "keys")) {
+    for (style in c("all2", "all", "keys")) {
       trial <- user.val
       trial[[nm]] <- wrap_val(nm, v, style)
       if (!is.null(try_opt(trial))) {
@@ -480,7 +481,7 @@ bmopt_build <- function(data_type, models, bm_format, p, n,
       for (a in names(v)) {
         cand <- c(keep, v[a])
         ok <- FALSE
-        for (style in c("all", "keys")) {
+        for (style in c("all2", "all", "keys")) {
           trial <- user.val
           trial[[nm]] <- wrap_val(nm, cand, style)
           if (!is.null(try_opt(trial))) { ok <- TRUE; break }
@@ -488,7 +489,7 @@ bmopt_build <- function(data_type, models, bm_format, p, n,
         if (ok) keep <- cand else dropped_args <- c(dropped_args, paste0(algo, "$", a))
       }
       if (length(keep) > 0) {
-        for (style in c("all", "keys")) {
+        for (style in c("all2", "all", "keys")) {
           trial <- user.val
           trial[[nm]] <- wrap_val(nm, keep, style)
           if (!is.null(try_opt(trial))) {
diff --git a/run_biomod.R b/run_biomod.R
index e89135c..1111710 100644
--- a/run_biomod.R
+++ b/run_biomod.R
@@ -719,6 +719,7 @@ mod_args <- list(
   nb.cpu      = nb_cpu,
   do.progress = TRUE
 )
+if (isTRUE(cfg$project_full_models)) mod_args$CV.do.full.models <- TRUE
 mod_args <- bmopt_inject(mod_args, built_opts)
 
 model_out <- tryCatch(do.call(BIOMOD_Modeling, mod_args), error = function(e) e)
@@ -878,6 +879,21 @@ if (!inherits(tmp_ev, "try-error") && !is.null(tmp_ev)) {
   if (isTRUE(has_val)) use_data <- "validation"
 }
 
+# ---- Tam veri modelleri ile projeksiyon (v1.2, cfg$project_full_models) ----
+# CV koşuları yalnız değerlendirme ve algoritma seçimi için kullanılır; ansambl ve
+# projeksiyon, her sözde-yok setinde tüm veriyle kurulan "allRun" modellerinden yapılır.
+# Büyük ızgaralarda projeksiyon yükünü CV katı sayısı kadar azaltır.
+use_full <- isTRUE(cfg$project_full_models)
+proj_models <- "all"
+if (use_full) {
+  algos_kept <- unique(sub(".*_", "", if (identical(models_chosen, "all")) built_full else models_chosen))
+  full <- built_full[grepl("_allRun_", built_full) & sub(".*_", "", built_full) %in% algos_kept]
+  if (length(full)) {
+    models_chosen <- full; proj_models <- full; use_data <- "calibration"
+    message("Ensemble/projection from full models: ", paste(full, collapse = ", "))
+  } else warning("project_full_models: no allRun models found; using CV models")
+}
+
 ens <- BIOMOD_EnsembleModeling(
   bm.mod = model_out,
   models.chosen = models_chosen,
@@ -1476,7 +1492,7 @@ proj_cur <- BIOMOD_Projection(
   bm.mod  = model_out,
   new.env = env,
   proj.name = "current",
-  models.chosen = "all",
+  models.chosen = proj_models,
   compress = "xz",
   build.clamping.mask = TRUE
 )
@@ -1570,7 +1586,7 @@ if (!do_future) {
         bm.mod  = model_out,
         new.env = env_f,
         proj.name = proj_name,
-        models.chosen = "all",
+        models.chosen = proj_models,
         compress = "xz",
         build.clamping.mask = TRUE
       )
